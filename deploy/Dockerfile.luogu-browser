FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir playwright==1.58.0 \
    && playwright install --with-deps chromium \
    && apt-get update \
    && apt-get install -y --no-install-recommends xvfb x11vnc novnc websockify \
    && rm -rf /var/lib/apt/lists/*
COPY luogu_proxy.py luogu_browser.py luogu_browser_relay.py luogu-browser-entrypoint.sh /app/
ENV DISPLAY=:99 LUOGU_PROXY_BACKEND=browser LUOGU_BROWSER_HEADLESS=false \
    LUOGU_BROWSER_PROFILE=/data/browser-profile HOST=0.0.0.0 PORT=8787
VOLUME ["/data"]
ENTRYPOINT ["sh", "/app/luogu-browser-entrypoint.sh"]
