PUBLIC_BASE_URL=https://oj-train-wall.wannafly.cn
BIND_ADDRESS=127.0.0.1
PORT=8017

# 生产环境如果走 HTTPS，建议打开安全 Cookie。
COOKIE_SECURE=true

# 自动同步间隔，单位秒。设为 0 可关闭后台同步，只保留手动刷新。
SYNC_INTERVAL_SECONDS=900
SYNC_MIN_AGE_SECONDS=120
FETCH_LOOKBACK_DAYS=3650
FETCH_LIMIT=1000
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRY_COUNT=2
HTTP_RETRY_BACKOFF_SECONDS=0.8
DISPLAY_TZ_OFFSET_HOURS=8

# 本地缓存：历史页会缓存，平台临时不可用时也可用旧响应/概览镜像兜底。
CACHE_DIR=/data/cache
HISTORICAL_CACHE_AFTER_DAYS=30
HISTORICAL_CACHE_TTL_SECONDS=315360000
OVERVIEW_CACHE_TTL_SECONDS=20

# 建议写成你的站点和联系方式，减少 OJ 侧风控误伤。
OJ_USER_AGENT=OJSubmissionWall/1.0 (+https://oj-train-wall.wannafly.cn)
LUOGU_USER_AGENT=OJSubmissionWall/1.0 (+https://oj-train-wall.wannafly.cn)

# 洛谷可能拦截海外机房出口。服务器在海外时，建议把洛谷请求转给国内出口的私有代理。
# 代理接口只应部署给自己用，并配置同一个 token。
LUOGU_CF_CLEARANCE=
LUOGU_COOKIE=
LUOGU_PROXY_URL=
LUOGU_PROXY_TOKEN=
# 主源失败时，尝试 api.jerryz.com.cn / luogu.wao3.cn 这类第三方公开卡片接口兜底总题数。
LUOGU_THIRD_PARTY_FALLBACK=true
LUOGU_FALLBACK_URLS=
# 洛谷逐条评测记录同步。默认每轮抓最近 3 页、历史回填 8 页，逐轮落库。
LUOGU_RECORD_SYNC=true
LUOGU_RECORD_RECENT_PAGES_PER_SYNC=3
LUOGU_RECORD_BACKFILL_PAGES_PER_SYNC=8
LUOGU_RECORD_SLEEP_MIN_SECONDS=0.4
LUOGU_RECORD_SLEEP_MAX_SECONDS=1.4

# QOJ 有 Cloudflare 校验；公开部署不建议收集用户登录态。留空时 QOJ 会提示无法精确同步。
QOJ_COOKIE=
