PUBLIC_BASE_URL=https://oj-wall.example.com
PORT=8000

# 生产环境如果走 HTTPS，建议打开安全 Cookie。
COOKIE_SECURE=true

# 自动同步间隔，单位秒。设为 0 可关闭后台同步，只保留手动刷新。
SYNC_INTERVAL_SECONDS=900
SYNC_MIN_AGE_SECONDS=120
FETCH_LOOKBACK_DAYS=3650
FETCH_LIMIT=1000

# 本地缓存：历史页会缓存，平台临时不可用时也可用旧响应/概览镜像兜底。
CACHE_DIR=/data/cache
HISTORICAL_CACHE_AFTER_DAYS=30
HISTORICAL_CACHE_TTL_SECONDS=315360000

# 建议写成你的站点和联系方式，减少 OJ 侧风控误伤。
OJ_USER_AGENT=OJSubmissionWall/1.0 (+https://oj-wall.example.com)

# QOJ 有 Cloudflare 校验；需要在服务端配置一个可访问 qoj.ac 的登录态 Cookie。
QOJ_COOKIE=

# 邮箱验证。未配置 SMTP 时，页面会直接返回验证链接；配置后会真正发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# QQ 邮箱常见配置示例：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_TLS=false
# SMTP_USER=your@qq.com
# SMTP_PASSWORD=你的 SMTP 授权码，不是 QQ 登录密码
# SMTP_FROM=your@qq.com
